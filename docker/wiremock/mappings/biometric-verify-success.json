{
  "request": {
    "method": "POST",
    "urlPath": "/biometric-service/v1/verify",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.token",
          "doesNotMatch": ".*1$"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "verified": true
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
