{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/scanner-service/v1/validate",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.token[?(@=~ /.*[^02]$/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "SUCCESS" }
  }
}