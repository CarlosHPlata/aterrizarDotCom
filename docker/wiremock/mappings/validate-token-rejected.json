{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/scanner-service/v1/validate",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.token[?(@=~ /.*2$/)]"
      }
    ]
  },
  "response": {
    "status": 406,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "REJECTED" }
  }
}